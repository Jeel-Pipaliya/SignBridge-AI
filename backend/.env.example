# SignBridge AI Backend Environment Configuration

# Project Metadata
PROJECT_NAME="SignBridge AI"
VERSION="1.0.0"
DEBUG=false

# Security (Generate a high-entropy 256-bit secret for production)
SECRET_KEY="replace-with-a-secure-random-secret-key-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Local SQLite default:
DATABASE_URL="sqlite:///./signbridge.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://signbridge_user:your_password@localhost:5432/signbridge_db"

# Model Paths (relative to project root)
STATIC_MODEL_PATH="models/best/isl_classifier.pkl"
STATIC_METADATA_PATH="models/metadata/model_metadata.json"
DYNAMIC_MODEL_PATH="models/dynamic/bilstm_dynamic.pt"
DYNAMIC_METADATA_PATH="models/metadata/dynamic_model_metadata.json"

# Inference Threshold
CONFIDENCE_THRESHOLD=0.70
